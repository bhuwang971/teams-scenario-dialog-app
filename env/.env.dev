# Copy this file to env/.env.dev and edit values.
# PowerShell: Copy-Item env\\.env.dev.example env\\.env.dev

PORT=<your port number>

# Public URL where this app server is reachable (for tab content URL)
PUBLIC_BASE_URL=https://<your-public-domain>

# Existing scenario backend (from your current Container App)
SCENARIO_API_BASE=

# Domain-only value used in Teams manifest validDomains
SCENARIO_API_DOMAIN=
